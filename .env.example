# Copy to .env and adjust values before running services or docker compose.
SECRET_KEY=REPLACE_WITH_TOKEN_URLSAFE_32
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf

# ClamAV (clamd). Leave CLAMAV_HOST empty to disable virus scanning.
# When set (e.g. clamav or localhost), uploads are rejected with HTTP 503 if clamd is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310

TOKEN_EXP_SECONDS=300
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
